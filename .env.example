# Public URL of the deployment (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob (create a Blob store in the Vercel dashboard and connect it,
# or copy the read-write token here for local development)
BLOB_READ_WRITE_TOKEN=

# Pusher Channels (server-side credentials — never exposed to the client)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Pusher Channels (public values only — safe to expose)
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# 32+ bytes of randomness, e.g. `openssl rand -base64 48`
SESSION_SIGNING_SECRET=

# 32+ bytes of randomness, used to HMAC IP addresses (raw IPs are never stored)
IP_HMAC_SECRET=

# Random secret used to authenticate the Vercel Cron cleanup job
CRON_SECRET=
